# Inject these on the host. Do not deploy this file.
# APP_ENV=production also follows from NODE_ENV=production.
#
# Render (current host): set only JWT_SECRET, EMAIL_PEPPER, and the DEFAULT_USER_*
# pair. Leave NODE_ENV / APP_ENV / PORT / SQLITE_PATH unset so Render's
# runtime-only NODE_ENV=production is used. Setting NODE_ENV=production in the
# dashboard also applies at build and omits client devDependencies.

NODE_ENV=production
APP_ENV=production
PORT=3001
JWT_SECRET=
EMAIL_PEPPER=
SQLITE_PATH=
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=
