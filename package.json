{
  "name": "foodpocalypse",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "test:pr-agent-models": "node --test scripts/check-pr-agent-models.test.mjs",
    "check:pr-agent-models": "node scripts/check-pr-agent-models.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
